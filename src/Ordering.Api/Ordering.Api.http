@host = http://localhost:5096

POST {{host}}/api/orders
Content-Type: application/json

{
  "customerName": "John Doe",
  "totalAmount": 199.99
}

### Create an order
POST {{host}}/orders
Content-Type: application/json

> {%
    client.global.set("orderId", response.body.orderId);
%}

### Accept the created order
POST {{host}}/orders/{{orderId}}/accept
